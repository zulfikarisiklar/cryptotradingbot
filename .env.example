# Binance API Configuration
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=True

# Trading Configuration
TRADING_SYMBOL=BTC/USDT
TRADING_TIMEFRAME=1h
INITIAL_CAPITAL=10000

# Risk Management
MAX_POSITION_SIZE=0.1  # 10% of portfolio
STOP_LOSS_PERCENT=0.02  # 2%
TAKE_PROFIT_MULTIPLIER=2.0  # 2x ATR
MAX_PYRAMID_LEVELS=3

# Safety Systems
ENABLE_EMERGENCY_STOP=True
ENABLE_MARKET_HOURS_FILTER=True  # Avoid stock market opening hours
ENABLE_CIRCUIT_BREAKER=True

# Emergency Stop Thresholds
CRASH_THRESHOLD_1M=-0.05  # -5% in 1 minute triggers emergency
CRASH_THRESHOLD_5M=-0.10  # -10% in 5 minutes
CRASH_THRESHOLD_15M=-0.15  # -15% in 15 minutes
VOLUME_SPIKE_THRESHOLD=5.0  # 5x normal volume

# Circuit Breaker Thresholds
MAX_DRAWDOWN_BEFORE_STOP=0.15  # 15% drawdown trips circuit breaker
MAX_CONSECUTIVE_LOSSES=5
CIRCUIT_BREAKER_COOLDOWN=60  # minutes

# Machine Learning
ML_LOOKBACK_PERIODS=100
ML_RETRAIN_INTERVAL=24  # hours

# Sentiment Analysis
NEWS_API_KEY=your_news_api_key_here
ENABLE_SENTIMENT=True

# Database
DATABASE_URL=sqlite:///trading_data.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

# ===== FUTURES TRADING CONFIGURATION =====

# Futures Trading Mode
ENABLE_FUTURES_TRADING=True
FUTURES_MARGIN_MODE=isolated  # isolated or cross

# Multi-Symbol Portfolio
MAX_POSITIONS=5  # Maximum concurrent positions
RISK_PER_TRADE=0.04  # 4% risk per trade

# Leverage Settings (User Configurable)
DEFAULT_LEVERAGE=10  # Default leverage multiplier (1-125)
MAX_LEVERAGE=20  # Maximum allowed leverage
MIN_LEVERAGE=1  # Minimum leverage

# Take Profit & Stop Loss (User Configurable)
ATR_MULTIPLIER_SL=2.0  # Stop loss ATR multiplier
ATR_MULTIPLIER_TP=3.0  # Take profit ATR multiplier (3.0 = 1.5:1 reward/risk)

# Signal Scanner Settings
MIN_SIGNAL_STRENGTH=60  # Minimum signal strength to trade (0-100)
MAX_SYMBOLS_TO_SCAN=50  # Number of symbols to scan
SCAN_INTERVAL=300  # Seconds between market scans (5 minutes)

# Liquidation Protection
ENABLE_LIQUIDATION_PROTECTION=True
LIQUIDATION_MARGIN_RATIO=0.9  # Close if margin drops to 90%
